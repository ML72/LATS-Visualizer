# =========================
# THIS PROJECT
# =========================

# From the Vite template's own ignore list, which this app was scaffolded from.
.DS_Store
*.local
dist-ssr

# Everything generated: LATS traces, rendered video, Manim's scratch cache,
# and the narration script written alongside each render.
/results/

# The virtualenv the scripts run in.
/.venv/

# NOT ignored, and deliberately so:
#   public/traces/   the traces the viewer ships with. Regenerate them with
#                    `python scripts/run_lats.py --publish`; the manifest
#                    carries no timestamp, so an unchanged run is a no-op diff.

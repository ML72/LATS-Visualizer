# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
# Only `python scripts/run_lats.py --llm openai` reads any of this. The default
# `--llm mock` policy needs no key and makes no network calls.

OPENAI_API_KEY=sk-...

# Optional. Points the OpenAI client at a compatible endpoint - a local server
# or a gateway - instead of api.openai.com. With one of these set, the key above
# may not be needed at all.
# OPENAI_BASE_URL=http://localhost:11434/v1
